<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Chess" parent="android:Theme.Material.NoActionBar">
        <!-- Dark variant: kills the white window flash before Compose attaches when
             the system is in dark mode. Matches DarkBackground in ui/theme/Color.kt. -->
        <item name="android:windowBackground">@color/brand_dark</item>
    </style>

    <!-- Dark variant of the cold-start splash theme: near-black background + tan mark,
         matching the app's dark M3 scheme. See values/themes.xml for the light variant. -->
    <style name="Theme.Chess.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Chess</item>
    </style>
</resources>
